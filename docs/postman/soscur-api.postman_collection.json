            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. PUT cursos no soportado (405)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{}" },
        "url": {
          "raw": "{{baseUrl}}/cursos",
          "host": ["{{baseUrl}}"],
          "path": ["cursos"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 405', () => pm.response.to.have.status(405));",
              "pm.test('Header Allow', () => pm.response.to.have.header('Allow', 'GET, POST'));"
            ]
          }
        }
      ]
    },
