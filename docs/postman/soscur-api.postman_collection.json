{
    "info": {
        "name": "SOSCUR API v1",
        "description": "Pruebas de los endpoints de /api/v1. Ejecutar en orden: las peticiones de POST /cursos dependen de la sesión que deja el login (Postman guarda la cookie PHPSESSID). El POST 201 crea un curso real: borrarlo después desde la base de datos si no se necesita.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost/PWCI/public/api/v1",
            "type": "string"
        },
        {
            "key": "corsAllowedOrigin",
            "value": "http://localhost:5500",
            "type": "string"
        },
        {
            "key": "corsDeniedOrigin",
            "value": "http://origen-no-autorizado.test",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "1. GET cursos por categoria (200)",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/cursos?categoria_id=3",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "cursos"
                    ],
                    "query": [
                        {
                            "key": "categoria_id",
                            "value": "3"
                        }
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Status 200', () => pm.response.to.have.status(200));",
                            "pm.test('Content-Type JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                            "pm.test('Incluye data y pagination', () => { const j = pm.response.json(); pm.expect(j.data).to.be.an('array'); pm.expect(j.pagination).to.have.property('total_pages'); });"
                        ]
                    }
                }
            ]
        },
