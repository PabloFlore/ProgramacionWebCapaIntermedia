        {
            "name": "13. CORS",
            "item": [
                {
                    "name": "13.1 Preflight origen permitido (204)",
                    "request": {
                        "method": "OPTIONS",
                        "header": [
                            {
                                "key": "Origin",
                                "value": "{{corsAllowedOrigin}}"
                            },
                            {
                                "key": "Access-Control-Request-Method",
                                "value": "PATCH"
                            },
                            {
                                "key": "Access-Control-Request-Headers",
                                "value": "content-type"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/perfil",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "perfil"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 204', () => pm.response.to.have.status(204));",
                                    "pm.test('Origen permitido', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql(pm.variables.get('corsAllowedOrigin')));",
                                    "pm.test('Credenciales', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Credentials')).to.eql('true'));",
                                    "pm.test('Metodos', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Methods')).to.include('PATCH'));",
                                    "pm.test('Headers', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Headers')).to.include('Content-Type'));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "13.2 Preflight origen denegado (403)",
                    "request": {
                        "method": "OPTIONS",
                        "header": [
                            {
                                "key": "Origin",
                                "value": "{{corsDeniedOrigin}}"
                            },
                            {
                                "key": "Access-Control-Request-Method",
                                "value": "PATCH"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/perfil",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
