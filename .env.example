# Copiar valores al entorno del servidor (Apache SetEnv, variables del sistema o
# export previo al servidor embebido). Este archivo NO se carga automáticamente.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=soscur_db
DB_USER=root
DB_PASS=

# URL pública base del portal, usada para construir enlaces en correos.
APP_URL=http://localhost/PWCI/public

# Integración de terceros: SendGrid (verificación de correo).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@tudominio.com
# true = modo sandbox de SendGrid (valida el envío sin entregar el correo).
SENDGRID_SANDBOX=true
